# MCP Server Configuration
# Command to start the Drasi MCP server
MCP_SERVER_COMMAND=python
# Arguments for the MCP server command
MCP_SERVER_ARGS=drasi_mcp_server.py
# Optional environment variables for the MCP server (JSON format)
# MCP_SERVER_ENV={"KEY": "value"}

# Azure OpenAI Configuration
# Your Azure OpenAI API key
AZURE_OPENAI_API_KEY=your-api-key-here
# Azure OpenAI endpoint URL
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# Deployment name for your model
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
# API version
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log format: simple, detailed, json
LOG_FORMAT=simple
