"""LangGraph-powered Terminator AI agent.

Architecture:
- NotificationLogger: Logs Drasi notifications with timestamps, tracks visited targets
- TerminatorAgent: Main agent with custom LangGraph workflow

Workflow:
1. Setup: Discover and subscribe to Drasi queries (one-time)
2. Loop: Wait 0.5s → Evaluate & Plan → Execute Move → Repeat

Planning:
- Only calls LLM when new notifications arrive or forced replan
- Validates paths to avoid walls before execution
- Retries up to 3 times if path invalid
- Marks targets as visited when reached
"""

import asyncio
import os
import random
import time
from dotenv import load_dotenv

from langchain_openai import AzureChatOpenAI
from langgraph.graph import StateGraph, START, MessagesState
from langgraph.prebuilt import ToolNode
from typing_extensions import TypedDict
from typing import Any, List, Dict
import asyncpg

from langchain_drasi import (
    create_drasi_tool,
    MCPConnectionConfig,
)
from langchain_drasi.callbacks import BaseDrasiNotificationHandler

from game_map import (
    get_random_spawn_position,
    get_adjacent_positions,
    is_valid_position,
    MAP_WIDTH,
    MAP_HEIGHT,
    WALL_CELLS,
)

# Load environment variables
load_dotenv()


# ============================================================================
# Notification Logging
# ============================================================================

class NotificationLogger(BaseDrasiNotificationHandler):
    """Logs all notifications without parsing them."""

    def __init__(self, agent_id: str):
        self.agent_id = agent_id
        self.notification_log: List[Dict[str, Any]] = []
        self.visited_targets: Dict[str, float] = {}  # Track visited player IDs with timestamps
        self.last_evaluated_count: int = 0  # Track when we last evaluated notifications

    def on_result_added(self, query_name: str, added_data: dict[str, Any]) -> None:
        """Log added notifications with timestamp."""
        log_entry = {
            "type": "added",
            "query": query_name,
            "data": added_data,
            "timestamp": time.time()
        }
        self.notification_log.append(log_entry)
        print(f"[{self.agent_id}] 🔔 Notification (added) from '{query_name}': {added_data}")

    def on_result_updated(self, query_name: str, updated_data: dict[str, Any]) -> None:
        """Log updated notifications with timestamp."""
        log_entry = {
            "type": "updated",
            "query": query_name,
            "data": updated_data,
            "timestamp": time.time()
        }
        self.notification_log.append(log_entry)
        print(f"[{self.agent_id}] 🔔 Notification (updated) from '{query_name}': {updated_data}")

    def on_result_deleted(self, query_name: str, deleted_data: dict[str, Any]) -> None:
        """Log deleted notifications with timestamp."""
        log_entry = {
            "type": "deleted",
            "query": query_name,
            "data": deleted_data,
            "timestamp": time.time()
        }
        self.notification_log.append(log_entry)
        print(f"[{self.agent_id}] 🔔 Notification (deleted) from '{query_name}': {deleted_data}")

    def get_recent_notifications(self, limit: int = 20) -> List[Dict[str, Any]]:
        """Get recent notifications, excluding visited targets."""
        # Filter out visited targets
        filtered = [
            entry for entry in self.notification_log
            if self._extract_player_id(entry) not in self.visited_targets.keys()
        ]
        return filtered[-limit:]

    def mark_target_visited(self, player_id: str) -> None:
        """Mark a target as visited with timestamp so it won't be selected again."""
        timestamp = time.time()
        self.visited_targets[player_id] = timestamp
        print(f"[{self.agent_id}] Marked {player_id} as visited at {timestamp}")

    def has_new_notifications(self) -> bool:
        """Check if there are new notifications since last evaluation."""
        return len(self.notification_log) > self.last_evaluated_count

    def mark_evaluated(self) -> None:
        """Mark current notification count as evaluated."""
        self.last_evaluated_count = len(self.notification_log)

    def _extract_player_id(self, entry: Dict[str, Any]) -> str | None:
        """Extract player ID from a notification entry."""
        data = entry.get("data", {})
        # Try common field names
        return data.get("id") or data.get("player") or data.get("p.id")


class HuntingState(MessagesState):
    """State for the hunting workflow with messages."""
    current_position: tuple[int, int]
    path: list[tuple[int, int]]
    current_target: str | None
    force_replan: bool  # Force replanning even without new notifications


# ============================================================================
# Terminator Agent
# ============================================================================

class TerminatorAgent:
    """A terminator agent that hunts players."""

    def __init__(
        self,
        agent_id: str,
        db_pool: asyncpg.Pool,
        drasi_server_url: str,
        llm: AzureChatOpenAI,
    ):
        self.agent_id = agent_id
        self.db_pool = db_pool
        self.x, self.y = get_random_spawn_position()
        self.llm = llm

        # Create notification logger
        self.notification_logger = NotificationLogger(agent_id)

        # Configure Drasi connection
        mcp_config = MCPConnectionConfig(
            server_url=drasi_server_url,
            headers={
                "Authorization": f"Bearer {os.getenv('DRASI_API_TOKEN')}"
            } if os.getenv("DRASI_API_TOKEN") else None,
            timeout=30.0,
        )

        # Create Drasi tool with notification logger
        self.drasi_tool = create_drasi_tool(
            mcp_config=mcp_config,
            notification_handlers=[self.notification_logger],
        )

        self.initialized = False
        self.current_path: list[tuple[int, int]] = []
        self.current_target: str | None = None

        # Build custom hunting workflow
        self.hunting_workflow = self._build_hunting_workflow()

    # ------------------------------------------------------------------------
    # Path Validation & Planning Helpers
    # ------------------------------------------------------------------------

    def _validate_path(self, start_pos: tuple[int, int], path: list[tuple[int, int]]) -> tuple[bool, str]:
        """Validate that a path is valid (all moves are adjacent and no walls).

        Returns:
            (is_valid, error_message)
        """
        if not path:
            return True, ""

        current_x, current_y = start_pos

        for i, (next_x, next_y) in enumerate(path):
            # Check if position is valid (not a wall)
            if not is_valid_position(next_x, next_y):
                return False, f"Step {i+1} at ({next_x},{next_y}) is a wall or out of bounds"

            # Check if move is adjacent
            if abs(next_x - current_x) + abs(next_y - current_y) != 1:
                return False, f"Step {i+1} from ({current_x},{current_y}) to ({next_x},{next_y}) is not adjacent"

            current_x, current_y = next_x, next_y

        return True, ""

    def _get_local_map_view(self, center_x: int, center_y: int, radius: int = 15) -> str:
        """Generate an ASCII map view centered on a position."""
        lines = []
        min_x = max(0, center_x - radius)
        max_x = min(MAP_WIDTH - 1, center_x + radius)
        min_y = max(0, center_y - radius)
        max_y = min(MAP_HEIGHT - 1, center_y + radius)

        lines.append(f"Map view centered at ({center_x},{center_y}), range x:{min_x}-{max_x}, y:{min_y}-{max_y}")

        for y in range(min_y, max_y + 1):
            line = f"{y:2d} "
            for x in range(min_x, max_x + 1):
                if x == center_x and y == center_y:
                    line += "T"
                elif (x, y) in WALL_CELLS:
                    line += "#"
                else:
                    line += "."
            lines.append(line)

        return "\n".join(lines)

    def _parse_llm_json(self, response_text: str) -> dict | None:
        """Parse JSON from LLM response, handling common formatting issues."""
        import json
        import re

        # Try to extract JSON from response
        match = re.search(r'\{.*\}', response_text, re.DOTALL)
        if not match:
            return None

        json_str = match.group(0)

        # Try standard JSON parsing
        try:
            return json.loads(json_str)
        except json.JSONDecodeError:
            pass

        # Try with single quotes replaced
        try:
            json_str = json_str.replace("'", '"')
            return json.loads(json_str)
        except json.JSONDecodeError:
            return None

    def _build_planning_prompt(self, current_x: int, current_y: int, notifications_str: str, visited_str: str) -> str:
        """Build the planning prompt for the LLM."""
        local_map = self._get_local_map_view(current_x, current_y, radius=15)

        return f"""You are a terminator AI at position ({current_x}, {current_y}).

Local map (T=you, #=wall, .=open):
{local_map}

Player notifications:
{notifications_str}

Previously visited targets:
{visited_str}

Task: Find CLOSEST unvisited player and create step-by-step path avoiding walls.

Algorithm:
1. Identify closest unvisited player from notifications
2. Plan path one cell at a time (up/down/left/right only)
3. Each step must be on '.' (open space), never on '#' (wall)
4. If blocked, route AROUND walls

Rules:
- Move only to adjacent cell (1 cell up/down/left/right)
- Never move to '#' wall cells
- Each step exactly 1 Manhattan distance from previous

IMPORTANT: Output ONLY JSON, no text before or after.

JSON format:
{{
  "target_player": "player_id",
  "path": [{{"x": 10, "y": 5}}, {{"x": 11, "y": 5}}, ...]
}}

If no unvisited players: {{"target_player": null, "path": []}}

JSON:"""

    # ------------------------------------------------------------------------
    # Workflow Construction
    # ------------------------------------------------------------------------

    def _build_hunting_workflow(self) -> StateGraph:
        """Build the custom hunting workflow graph."""
        workflow = StateGraph(HuntingState)

        # Add nodes
        workflow.add_node("setup_queries_prompt", self._setup_queries_prompt_node)
        workflow.add_node("setup_queries_call_model", self._call_model_node)
        workflow.add_node("setup_queries_tools", ToolNode([self.drasi_tool]))
        workflow.add_node("wait_for_data", self._wait_for_data_node)
        workflow.add_node("evaluate_and_plan", self._evaluate_and_plan_node)
        workflow.add_node("execute_move", self._execute_move_node)

        # Add edges
        def route_start(state: HuntingState) -> str:
            """Skip setup if already initialized."""
            if self.initialized:
                return "wait_for_data"
            return "setup_queries_prompt"

        workflow.add_conditional_edges(START, route_start, ["setup_queries_prompt", "wait_for_data"])
        workflow.add_edge("setup_queries_prompt", "setup_queries_call_model")

        def should_continue_setup(state: HuntingState) -> str:
            """Check if LLM wants to call more tools."""
            last_message = state["messages"][-1]
            if hasattr(last_message, 'tool_calls') and last_message.tool_calls:
                return "setup_queries_tools"
            return "wait_for_data"

        workflow.add_conditional_edges("setup_queries_call_model", should_continue_setup, ["setup_queries_tools", "wait_for_data"])
        workflow.add_edge("setup_queries_tools", "setup_queries_call_model")  # Loop back for more tool calls

        # Main hunting loop
        workflow.add_edge("wait_for_data", "evaluate_and_plan")
        workflow.add_edge("evaluate_and_plan", "execute_move")
        workflow.add_edge("execute_move", "wait_for_data")  # Loop back to wait for next iteration

        return workflow.compile()

    # ------------------------------------------------------------------------
    # Workflow Nodes
    # ------------------------------------------------------------------------

    async def _setup_queries_prompt_node(self, state: HuntingState) -> HuntingState:
        """Node: Add initial prompt for query setup (only once)."""
        if self.initialized:
            return state

        print(f"[{self.agent_id}] Setting up query subscriptions...")

        from langchain_core.messages import HumanMessage

        setup_prompt = """You have access to the drasi_query tool. Use it to:
1. Discover what queries are available (operation="discover")
2. Subscribe to all queries that track player positions (operation="subscribe" with query_name)

Do this now."""

        return {**state, "messages": [HumanMessage(content=setup_prompt)]}

    async def _call_model_node(self, state: HuntingState) -> HuntingState:
        """Node: Call LLM with tools bound."""
        response = await self.llm.bind_tools([self.drasi_tool]).ainvoke(state["messages"])

        # Check if setup is complete (no more tool calls)
        if not self.initialized and (not hasattr(response, 'tool_calls') or not response.tool_calls):
            print(f"[{self.agent_id}] ✓ Query setup complete")
            self.initialized = True

        # Return response - MessagesState automatically appends to messages
        return {"messages": [response]}

    async def _wait_for_data_node(self, state: HuntingState) -> HuntingState:
        """Node: Wait for 0.5 seconds for new notifications."""
        await asyncio.sleep(0.5)
        return state

    async def _evaluate_and_plan_node(self, state: HuntingState) -> HuntingState:
        """Node: Evaluate notifications and plan path to closest player."""
        current_x, current_y = state['current_position']
        force_replan = state.get('force_replan', False)

        # Early exit: continue current path if no new data
        if not self.notification_logger.has_new_notifications() and not force_replan:
            if self.current_path:
                print(f"[{self.agent_id}] No new notifications, continuing current path")
                return {"path": self.current_path, "current_target": self.current_target, "force_replan": False}
            return self._random_patrol_move(current_x, current_y)

        # Get recent notifications (excluding visited targets)
        recent_notifications = self.notification_logger.get_recent_notifications()
        if not recent_notifications:
            print(f"[{self.agent_id}] No unvisited targets in notifications, patrolling...")
            return self._random_patrol_move(current_x, current_y) if not self.current_path else \
                   {"path": self.current_path, "current_target": self.current_target, "force_replan": False}

        # Plan new path using LLM
        return await self._plan_path_with_llm(current_x, current_y, recent_notifications, force_replan)

    def _random_patrol_move(self, x: int, y: int) -> dict:
        """Generate a random patrol move."""
        valid_moves = get_adjacent_positions(x, y)
        if valid_moves:
            return {"path": [random.choice(valid_moves)], "current_target": None, "force_replan": False}
        return {"path": [], "current_target": None, "force_replan": False}

    async def _plan_path_with_llm(self, current_x: int, current_y: int,
                                   recent_notifications: list, force_replan: bool) -> dict:
        """Use LLM to plan a path to the closest player."""
        import json
        from langchain_core.messages import HumanMessage

        # Log planning reason
        if force_replan:
            print(f"[{self.agent_id}] Forced replanning due to invalid move")
        else:
            print(f"[{self.agent_id}] New notifications detected, re-evaluating strategy")

        # Prepare prompt data
        notifications_str = json.dumps(recent_notifications, indent=2)
        visited_str = json.dumps({
            player_id: {"visited_at": timestamp}
            for player_id, timestamp in self.notification_logger.visited_targets.items()
        }, indent=2)

        # Retry up to 3 times to get a valid path
        for attempt in range(3):
            try:
                # Build and send prompt
                planning_prompt = self._build_planning_prompt(current_x, current_y, notifications_str, visited_str)
                response = await self.llm.ainvoke([HumanMessage(content=planning_prompt)])
                response_text = response.content.strip()

                # Parse JSON response
                result = self._parse_llm_json(response_text)
                if not result:
                    print(f"[{self.agent_id}] ⚠ Could not parse JSON (attempt {attempt+1}/3)")
                    print(f"[{self.agent_id}] Response: {response_text[:200]}")
                    continue

                # Extract path and target
                target_player = result.get("target_player")
                path = [(step["x"], step["y"]) for step in result.get("path", [])]

                # Validate path
                if path:
                    is_valid, error_msg = self._validate_path((current_x, current_y), path)
                    if not is_valid:
                        print(f"[{self.agent_id}] ⚠ Invalid path (attempt {attempt+1}/3): {error_msg}")
                        if attempt < 2:
                            print(f"[{self.agent_id}] Retrying path generation...")
                            continue
                        else:
                            print(f"[{self.agent_id}] Max retries reached, giving up on path")
                            return {"path": [], "current_target": None, "force_replan": False}

                # Update path and target
                return self._update_path_and_target(target_player, path)

            except Exception as e:
                print(f"[{self.agent_id}] ⚠ Error planning path (attempt {attempt+1}/3): {e}")
                if attempt == 2:
                    return {"path": self.current_path, "current_target": self.current_target, "force_replan": False}

        # Fallback if all retries fail
        return {"path": self.current_path, "current_target": self.current_target, "force_replan": False}

    def _update_path_and_target(self, target_player: str | None, path: list[tuple[int, int]]) -> dict:
        """Update current path and target based on LLM planning result."""
        # New target with valid path
        if target_player != self.current_target and path:
            print(f"[{self.agent_id}] New target: {target_player}, {len(path)} steps")
            print(f"[{self.agent_id}] Path: {' -> '.join(f'({x},{y})' for x, y in path)}")
            self.current_target = target_player
            self.current_path = path
        # Same target, keep current path
        elif self.current_path and target_player == self.current_target:
            print(f"[{self.agent_id}] Continuing to {self.current_target}, {len(self.current_path)} steps left")
            path = self.current_path
        # No valid target
        else:
            print(f"[{self.agent_id}] No valid target")
            self.current_target = None
            self.current_path = []

        # Mark notifications as processed
        self.notification_logger.mark_evaluated()

        return {"path": path, "current_target": target_player, "force_replan": False}

    async def _execute_move_node(self, state: HuntingState) -> HuntingState:
        """Node: Execute the next move in the path."""
        path = state.get("path", [])

        if not path:
            # No path, patrol randomly
            valid_moves = get_adjacent_positions(self.x, self.y)
            if valid_moves:
                new_x, new_y = random.choice(valid_moves)
                await self._move_to(new_x, new_y)
                print(f"[{self.agent_id}] Patrolling")
            return {"current_position": (self.x, self.y), "force_replan": False}

        # Take next step from path
        next_x, next_y = path[0]

        # Validate the move
        valid_moves = get_adjacent_positions(self.x, self.y)
        if (next_x, next_y) in valid_moves:
            await self._move_to(next_x, next_y)

            # Update path - remove completed step
            self.current_path = path[1:]

            # Check if we've reached the target
            if len(self.current_path) == 0 and self.current_target:
                print(f"[{self.agent_id}] Reached target {self.current_target}")
                self.notification_logger.mark_target_visited(self.current_target)
                self.current_target = None
            elif self.current_target:
                print(f"[{self.agent_id}] {len(self.current_path)} steps remaining to {self.current_target}")

            return {"current_position": (self.x, self.y), "force_replan": False}
        else:
            # Hit an invalid move (wall or obstacle)
            print(f"[{self.agent_id}] ⚠ Hit invalid move to ({next_x},{next_y}), forcing replan")
            self.current_path = []
            # Keep the target but force replanning to find a new path
            return {"current_position": (self.x, self.y), "force_replan": True}

    # ------------------------------------------------------------------------
    # Game Logic (Movement & Collision)
    # ------------------------------------------------------------------------

    async def _move_to(self, new_x: int, new_y: int) -> None:
        """Move to a new position and check collisions."""
        # Update database
        async with self.db_pool.acquire() as conn:
            await conn.execute(
                "UPDATE player SET x = $1, y = $2 WHERE id = $3",
                new_x, new_y, self.agent_id
            )

        self.x, self.y = new_x, new_y
        print(f"[{self.agent_id}] Moved to ({self.x}, {self.y})")

        await self.check_collisions()

    async def initialize(self) -> None:
        """Initialize the terminator by inserting into database."""
        # Insert terminator into database
        async with self.db_pool.acquire() as conn:
            try:
                await conn.execute(
                    "INSERT INTO player (id, x, y, type) VALUES ($1, $2, $3, $4)",
                    self.agent_id, self.x, self.y, 'ai'
                )
            except asyncpg.UniqueViolationError:
                # Already exists, update position
                await conn.execute(
                    "UPDATE player SET x = $1, y = $2, type = $3 WHERE id = $4",
                    self.x, self.y, 'ai', self.agent_id
                )

        print(f"[{self.agent_id}] Spawned at ({self.x}, {self.y})")
        print(f"[{self.agent_id}] Query subscriptions will be set up by workflow")

    async def check_collisions(self) -> None:
        """Check if the terminator has caught any players."""
        async with self.db_pool.acquire() as conn:
            # Find human players at the same position
            caught_players = await conn.fetch(
                "SELECT id FROM player WHERE x = $1 AND y = $2 AND id != $3 AND type = 'human'",
                self.x, self.y, self.agent_id
            )

            for row in caught_players:
                player_id = row["id"]
                await conn.execute("DELETE FROM player WHERE id = $1", player_id)
                print(f"[{self.agent_id}] ELIMINATED player '{player_id}'!")

    # ------------------------------------------------------------------------
    # Lifecycle Methods
    # ------------------------------------------------------------------------

    async def run(self) -> None:
        """Run the terminator continuously with the hunting workflow."""
        # Create initial state
        initial_state: HuntingState = {
            "messages": [],
            "current_position": (self.x, self.y),
            "path": [],
            "current_target": self.current_target,
            "force_replan": False,
        }

        # Run the workflow - it will loop internally with high recursion limit
        config = {"recursion_limit": 10000}
        try:
            await self.hunting_workflow.ainvoke(initial_state, config=config)
        except Exception as e:
            print(f"[{self.agent_id}] ⚠ Error in hunting workflow: {e}")

    async def shutdown(self) -> None:
        """Clean up the terminator."""
        print(f"[{self.agent_id}] Shutdown")


async def run_terminator(agent_id: str, db_pool: asyncpg.Pool) -> None:
    """Run a single terminator agent."""
    # Configure LLM
    llm = AzureChatOpenAI(
        azure_deployment=os.getenv("AZURE_OPENAI_DEPLOYMENT", "gpt-4o-mini"),
        api_version=os.getenv("AZURE_OPENAI_API_VERSION", "2024-02-15-preview"),
        temperature=0,
    )

    # Configure Drasi server
    drasi_server_url = os.getenv("DRASI_SERVER_URL", "http://localhost:8083")

    # Create and initialize terminator
    terminator = TerminatorAgent(agent_id, db_pool, drasi_server_url, llm)
    await terminator.initialize()

    # Run the terminator (it will loop internally with 0.5s wait)
    try:
        await terminator.run()
    except asyncio.CancelledError:
        await terminator.shutdown()
        raise
